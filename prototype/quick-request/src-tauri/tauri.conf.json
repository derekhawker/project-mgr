{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Quick Request Prototype",
  "version": "0.1.0",
  "identifier": "dev.opencode.projectmgr.quickrequestprototype",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Quick Request Prototype",
        "width": 1180,
        "height": 850,
        "minWidth": 820,
        "minHeight": 650,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": []
  }
}
